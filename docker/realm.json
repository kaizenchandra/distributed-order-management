{
  "realm": "oms",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "oms-demo",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "profile",
        "email",
        "oms"
      ],
      "redirectUris": [
        "http://localhost:*"
      ]
    },
    {
      "clientId": "oms-internal",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "secret": "__SERVICE_SECRET__",
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "oms",
        "oms.service",
        "oms.admin"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "oms",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "oms",
            "access.token.claim": "true"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "oms.service",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "oms.admin",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    }
  ],
  "users": [
    {
      "username": "customer",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-customer-only",
          "temporary": false
        }
      ],
      "firstName": "Local",
      "lastName": "customer",
      "email": "customer@example.test",
      "emailVerified": true,
      "requiredActions": []
    },
    {
      "username": "other",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-customer-only",
          "temporary": false
        }
      ],
      "firstName": "Local",
      "lastName": "other",
      "email": "other@example.test",
      "emailVerified": true,
      "requiredActions": []
    }
  ]
}